{
  "name": "@workspace/ledger-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "start": "expo start --lan --dev-client",
    "start:tunnel": "expo start --tunnel --dev-client",
    "start:clear": "expo start --lan --clear --dev-client",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eas:build:preview": "eas build -p ios --profile preview",
    "eas:build:production": "eas build -p ios --profile production",
    "eas:submit": "eas submit -p ios --latest",
    "tf:build": "eas build -p ios --profile production --non-interactive --auto-submit --no-wait",
    "tf:build:wait": "eas build -p ios --profile production --non-interactive --auto-submit",
    "ota:production": "EAS_NO_VCS=1 EXPO_USE_METRO_WORKSPACE_ROOT=1 EXPO_PUBLIC_DOMAIN=binance-loan-tracker-backend.azurewebsites.net eas update --branch production --environment production --non-interactive"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@bacons/apple-targets": "^5.0.0",
